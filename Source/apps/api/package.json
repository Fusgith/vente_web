{
  "name": "@vente-web/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API — single source of truth for the shop (Prisma, PostgreSQL, Socket.IO)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --conditions=development --env-file-if-exists=../../.env watch src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@vente-web/shared": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
