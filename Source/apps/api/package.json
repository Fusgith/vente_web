{
  "name": "@vente-web/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API — single source of truth for the shop (Prisma, PostgreSQL, Socket.IO)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "prisma generate && tsc -b",
    "typecheck": "prisma generate && tsc -b && tsc -p prisma && tsc -p tsconfig.test.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "admin:bootstrap": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/admin-bootstrap.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fontsource/asap": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vente-web/shared": "workspace:*",
    "exceljs": "4.4.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "otpauth": "^9.5.2",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
