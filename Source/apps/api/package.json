{
  "name": "@vente-web/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API — single source of truth for the shop (Prisma, PostgreSQL, Socket.IO)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --conditions=development --env-file-if-exists=../../.env watch src/index.ts",
    "build": "prisma generate && tsc -b",
    "typecheck": "prisma generate && tsc -b && tsc -p prisma",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vente-web/shared": "workspace:*",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
