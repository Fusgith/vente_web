// Stock movements, reservations and Excel import batches — RG-STK-*, RG-IMP-*.

enum MovementType {
  IMPORT
  ADJUSTMENT
  DELIVERY
  RETURN
  STOCKTAKE

  @@map("movement_type")
}

enum ImportMode {
  ENTRY
  STOCKTAKE

  @@map("import_mode")
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  CANCELLED

  @@map("import_status")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED

  @@map("reservation_status")
}

/// Append-only ledger (no UPDATE/DELETE, trigger in the migration); qty is signed, in base unit.
model StockMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  type          MovementType
  /// Signed quantity in base unit: qty = unit_qty × factor at movement time (RG-ART-06).
  qty           Decimal      @db.Decimal(12, 2)
  productUnitId String?      @map("product_unit_id") @db.Uuid
  /// Quantity as typed, in the sale unit (null when entered directly in base unit).
  unitQty       Decimal?     @map("unit_qty") @db.Decimal(12, 2)
  importBatchId String?      @map("import_batch_id") @db.Uuid
  /// Goods entry date carried by the import (RG-IMP-07), distinct from created_at.
  entryDate     DateTime?    @map("entry_date") @db.Date
  orderId       String?      @map("order_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  reason        String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  product     Product      @relation(fields: [productId], references: [id])
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])
  order       Order?       @relation(fields: [orderId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([importBatchId])
  @@index([orderId])
  @@map("stock_movements")
}

/// Quantity blocked for a validated order until day end or delivery (RG-STK-02/03).
model Reservation {
  id        String            @id @default(uuid(7)) @db.Uuid
  orderId   String            @map("order_id") @db.Uuid
  productId String            @map("product_id") @db.Uuid
  /// Base unit (sum of the order lines for this product, RG-CMD-02).
  qty       Decimal           @db.Decimal(12, 2)
  /// Null = firm (paid order); otherwise the day end (`day_end_time`).
  expiresAt DateTime?         @map("expires_at") @db.Timestamptz(6)
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt  DateTime?         @map("closed_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([status, expiresAt])
  @@map("reservations")
}

/// One uploaded Excel file: previewed, then committed or cancelled (RG-IMP-01 à 08).
model ImportBatch {
  id          String       @id @default(uuid(7)) @db.Uuid
  filePath    String       @map("file_path")
  fileName    String       @map("file_name") @db.VarChar(255)
  mode        ImportMode
  status      ImportStatus @default(PREVIEW)
  entryDate   DateTime     @map("entry_date") @db.Date
  userId      String       @map("user_id") @db.Uuid
  rowsTotal   Int          @default(0) @map("rows_total")
  rowsOk      Int          @default(0) @map("rows_ok")
  rowsError   Int          @default(0) @map("rows_error")
  /// Parsed rows with their status, shown before committing (RG-IMP-04).
  preview     Json?
  summary     Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt DateTime?    @map("committed_at") @db.Timestamptz(6)

  user      User            @relation(fields: [userId], references: [id])
  movements StockMovement[]
  prices    ProductPrice[]

  @@index([status, createdAt])
  @@map("import_batches")
}
