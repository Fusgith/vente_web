// Catalog: categories, products, sale units, price history, stock — RG-ART-*, RG-STK-01.

enum PriceSource {
  IMPORT
  MANUAL

  @@map("price_source")
}

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String   @unique @db.VarChar(80)
  /// Discount cap fallback for its products (RG-REM-01); null → global setting.
  maxDiscountPct Decimal? @map("max_discount_pct") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products      Product[]
  discountRules DiscountRule[]

  @@map("categories")
}

/// No price on the product itself (RG-ART-03): prices belong to sale units.
model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Unique case-insensitively (index on lower(sku) in the migration).
  sku            String    @unique @db.VarChar(64)
  name           String    @db.VarChar(200)
  categoryId     String?   @map("category_id") @db.Uuid
  /// Label of the counting unit (pièce, kg, m…); stock is kept in it (RG-ART-06).
  baseUnit       String    @map("base_unit") @db.VarChar(20)
  maxDiscountPct Decimal?  @map("max_discount_pct") @db.Decimal(5, 2)
  alertThreshold Decimal?  @map("alert_threshold") @db.Decimal(12, 2)
  isActive       Boolean   @default(true) @map("is_active")
  lastEntryAt    DateTime? @map("last_entry_at") @db.Timestamptz(6)
  /// Normalized words of code, designation and active unit labels, for the quick search
  /// (RG-DEV-06). Maintained by triggers (migration add_product_search): never written here.
  searchText     String    @default("") @map("search_text")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category      Category?             @relation(fields: [categoryId], references: [id])
  units         ProductUnit[]
  stock         ProductStock?
  movements     StockMovement[]
  reservations  Reservation[]
  orderLines    OrderLine[]
  codeItems     DiscountCodeItem[]
  requestItems  DiscountRequestItem[]
  promotions    ProductPromotion[]
  discountRules DiscountRule[]

  @@index([categoryId])
  @@index([name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_trgm_idx")
  @@map("products")
}

/// Sale unit: label + factor to base unit + optional barcode and discount cap (RG-ART-06).
model ProductUnit {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  label          String   @db.VarChar(40)
  /// Base units per sale unit; CHECK factor > 0 and is_base ⇒ factor = 1 (migration).
  factor         Decimal  @db.Decimal(12, 3)
  /// Exactly one base unit per product (partial unique index in the migration).
  isBase         Boolean  @default(false) @map("is_base")
  barcode        String?  @unique @db.VarChar(64)
  maxDiscountPct Decimal? @map("max_discount_pct") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product         @relation(fields: [productId], references: [id])
  prices     ProductPrice[]
  movements  StockMovement[]
  orderLines OrderLine[]

  @@unique([productId, label])
  @@map("product_units")
}

/// Append-only price history (RG-ART-07): a new price closes the previous one; never overwritten.
model ProductPrice {
  id            String        @id @default(uuid(7)) @db.Uuid
  productUnitId String        @map("product_unit_id") @db.Uuid
  price         Decimal       @db.Decimal(14, 2)
  effectiveFrom DateTime      @default(now()) @map("effective_from") @db.Timestamptz(6)
  /// Null = current price; at most one per unit and customer type (partial unique index).
  effectiveTo   DateTime?     @map("effective_to") @db.Timestamptz(6)
  source        PriceSource
  importBatchId String?       @map("import_batch_id") @db.Uuid
  /// Null = the base price; else the price of that customer type, which wins over it (H66).
  customerType  CustomerType? @map("customer_type")
  setById       String        @map("set_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  productUnit ProductUnit  @relation(fields: [productUnitId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])
  setBy       User         @relation("PriceSetBy", fields: [setById], references: [id])
  orderLines  OrderLine[]

  @@index([productUnitId, effectiveFrom(sort: Desc)])
  @@map("product_prices")
}

/// One stock per product, in base unit (RG-ART-06); CHECK 0 ≤ reserved ≤ on_hand (migration).
model ProductStock {
  productId String   @id @map("product_id") @db.Uuid
  onHand    Decimal  @default(0) @map("on_hand") @db.Decimal(12, 2)
  reserved  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@map("product_stock")
}

/// A product the owner marks « à proposer » to the salespeople (RG-DEV-06 §6, H46, H49 b), from
/// `startsOn` to `endsOn`, both included (shop days). Never a price change (RG-ART-07).
model ProductPromotion {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  startsOn    DateTime  @map("starts_on") @db.Date
  /// Not before `startsOn` (CHECK in the migration).
  endsOn      DateTime  @map("ends_on") @db.Date
  /// What to tell the customer, optional.
  pitch       String?   @db.VarChar(200)
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Withdrawn before its end: no longer shown, kept for the audit.
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([endsOn])
  @@map("product_promotions")
}

enum DiscountRuleKind {
  QUANTITY
  CUSTOMER_CATEGORY
  PROMOTION

  @@map("discount_rule_kind")
}

/// A discount the owner plans (H62): by quantity, by customer category or over a promotion
/// period, on one product, one category of products or, both null, every product. Never applied
/// by itself: the cashier applies it at the customer's request (H61); it widens the line's limit.
model DiscountRule {
  id               String           @id @default(uuid(7)) @db.Uuid
  kind             DiscountRuleKind
  /// At most one of the two (CHECK in the migration).
  productId        String?          @map("product_id") @db.Uuid
  categoryId       String?          @map("category_id") @db.Uuid
  /// In base units of one product (RG-ART-06), for QUANTITY only.
  minQty           Decimal?         @map("min_qty") @db.Decimal(12, 2)
  /// One of the shop's customer categories (H49 a), for CUSTOMER_CATEGORY only.
  customerCategory String?          @map("customer_category") @db.VarChar(40)
  /// More than 0, 100 at most (CHECK in the migration).
  pct              Decimal          @db.Decimal(5, 2)
  /// Shop days, both included; both set for PROMOTION, ends not before starts.
  startsOn         DateTime?        @map("starts_on") @db.Date
  endsOn           DateTime?        @map("ends_on") @db.Date
  isActive         Boolean          @default(true) @map("is_active")
  createdById      String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product?  @relation(fields: [productId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([isActive])
  @@map("discount_rules")
}
