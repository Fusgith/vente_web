// Catalog: categories, products, sale units, price history, stock — RG-ART-*, RG-STK-01.

enum PriceSource {
  IMPORT
  MANUAL

  @@map("price_source")
}

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String   @unique @db.VarChar(80)
  /// Discount cap fallback for its products (RG-REM-01); null → global setting.
  maxDiscountPct Decimal? @map("max_discount_pct") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

/// No price on the product itself (RG-ART-03): prices belong to sale units.
model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Unique case-insensitively (index on lower(sku) in the migration).
  sku            String    @unique @db.VarChar(64)
  name           String    @db.VarChar(200)
  categoryId     String?   @map("category_id") @db.Uuid
  /// Label of the counting unit (pièce, kg, m…); stock is kept in it (RG-ART-06).
  baseUnit       String    @map("base_unit") @db.VarChar(20)
  maxDiscountPct Decimal?  @map("max_discount_pct") @db.Decimal(5, 2)
  alertThreshold Decimal?  @map("alert_threshold") @db.Decimal(12, 2)
  isActive       Boolean   @default(true) @map("is_active")
  lastEntryAt    DateTime? @map("last_entry_at") @db.Timestamptz(6)
  /// Normalized words of code, designation and active unit labels, for the quick search
  /// (RG-DEV-06). Maintained by triggers (migration add_product_search): never written here.
  searchText     String    @default("") @map("search_text")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     Category?             @relation(fields: [categoryId], references: [id])
  units        ProductUnit[]
  stock        ProductStock?
  movements    StockMovement[]
  reservations Reservation[]
  orderLines   OrderLine[]
  codeItems    DiscountCodeItem[]
  requestItems DiscountRequestItem[]

  @@index([categoryId])
  @@index([name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_trgm_idx")
  @@map("products")
}

/// Sale unit: label + factor to base unit + optional barcode and discount cap (RG-ART-06).
model ProductUnit {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  label          String   @db.VarChar(40)
  /// Base units per sale unit; CHECK factor > 0 and is_base ⇒ factor = 1 (migration).
  factor         Decimal  @db.Decimal(12, 3)
  /// Exactly one base unit per product (partial unique index in the migration).
  isBase         Boolean  @default(false) @map("is_base")
  barcode        String?  @unique @db.VarChar(64)
  maxDiscountPct Decimal? @map("max_discount_pct") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product         @relation(fields: [productId], references: [id])
  prices     ProductPrice[]
  movements  StockMovement[]
  orderLines OrderLine[]

  @@unique([productId, label])
  @@map("product_units")
}

/// Append-only price history (RG-ART-07): a new price closes the previous one; never overwritten.
model ProductPrice {
  id            String      @id @default(uuid(7)) @db.Uuid
  productUnitId String      @map("product_unit_id") @db.Uuid
  price         Decimal     @db.Decimal(14, 2)
  effectiveFrom DateTime    @default(now()) @map("effective_from") @db.Timestamptz(6)
  /// Null = current price; at most one per unit (partial unique index in the migration).
  effectiveTo   DateTime?   @map("effective_to") @db.Timestamptz(6)
  source        PriceSource
  importBatchId String?     @map("import_batch_id") @db.Uuid
  setById       String      @map("set_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  productUnit ProductUnit  @relation(fields: [productUnitId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])
  setBy       User         @relation("PriceSetBy", fields: [setById], references: [id])
  orderLines  OrderLine[]

  @@index([productUnitId, effectiveFrom(sort: Desc)])
  @@map("product_prices")
}

/// One stock per product, in base unit (RG-ART-06); CHECK 0 ≤ reserved ≤ on_hand (migration).
model ProductStock {
  productId String   @id @map("product_id") @db.Uuid
  onHand    Decimal  @default(0) @map("on_hand") @db.Decimal(12, 2)
  reserved  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@map("product_stock")
}
