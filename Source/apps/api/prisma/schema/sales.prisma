// Customers, quotes/orders, order lines, discount requests and codes — RG-DEV, RG-CMD, RG-REM, RG-TKT.

/// Order lifecycle (CDC métier §5.2).
enum OrderStatus {
  DRAFT
  SUBMITTED
  AT_REGISTER
  PAID
  PREPARING
  READY
  ISSUE
  DELIVERED
  EXPIRED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum DiscountSource {
  NONE
  WITHIN_CAP
  CODE

  @@map("discount_source")
}

enum DiscountRequestStatus {
  PENDING
  GRANTED
  REJECTED

  @@map("discount_request_status")
}

enum DiscountCodeStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED

  @@map("discount_code_status")
}

/// Name and phone are mandatory; phone unique among active customers (RG-DEV-04, partial index).
model Customer {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(120)
  phone        String   @db.VarChar(32)
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  /// Set when this record was merged into another one (deduplication).
  mergedIntoId String?  @map("merged_into_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mergedInto       Customer?         @relation("CustomerMerge", fields: [mergedIntoId], references: [id])
  mergedFrom       Customer[]        @relation("CustomerMerge")
  orders           Order[]
  discountRequests DiscountRequest[]
  discountCodes    DiscountCode[]

  @@index([name])
  @@map("customers")
}

/// A quote (DRAFT) that becomes an order once validated by the sales user (RG-CMD-*).
model Order {
  id                String      @id @default(uuid(7)) @db.Uuid
  number            String      @unique @db.VarChar(32)
  status            OrderStatus @default(DRAFT)
  salesUserId       String      @map("sales_user_id") @db.Uuid
  customerId        String      @map("customer_id") @db.Uuid
  /// Call ticket "A15": letter of the sales user + daily sequence (RG-TKT-01).
  ticketLetter      String?     @map("ticket_letter") @db.Char(1)
  ticketSeq         Int?        @map("ticket_seq")
  ticketDate        DateTime?   @map("ticket_date") @db.Date
  queueRank         Int?        @map("queue_rank")
  priority          Int         @default(0)
  noShowCount       Int         @default(0) @map("no_show_count")
  registerStationId String?     @map("register_station_id") @db.Uuid
  cashierUserId     String?     @map("cashier_user_id") @db.Uuid
  subtotal          Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal     @default(0) @map("discount_total") @db.Decimal(14, 2)
  vatTotal          Decimal     @default(0) @map("vat_total") @db.Decimal(14, 2)
  rounding          Decimal     @default(0) @db.Decimal(14, 2)
  total             Decimal     @default(0) @db.Decimal(14, 2)
  /// Reservation deadline = day end (RG-CMD-08); null once paid.
  expiresAt         DateTime?   @map("expires_at") @db.Timestamptz(6)
  submittedAt       DateTime?   @map("submitted_at") @db.Timestamptz(6)
  calledAt          DateTime?   @map("called_at") @db.Timestamptz(6)
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz(6)
  readyAt           DateTime?   @map("ready_at") @db.Timestamptz(6)
  deliveredAt       DateTime?   @map("delivered_at") @db.Timestamptz(6)
  cancelReason      String?     @map("cancel_reason")
  /// Optimistic locking: every update checks and increments it.
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  salesUser        User              @relation("OrderSalesUser", fields: [salesUserId], references: [id])
  cashierUser      User?             @relation("OrderCashierUser", fields: [cashierUserId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  registerStation  Station?          @relation("OrderRegisterStation", fields: [registerStationId], references: [id])
  lines            OrderLine[]
  reservations     Reservation[]
  stockMovements   StockMovement[]
  discountRequests DiscountRequest[]
  discountCodes    DiscountCode[]    @relation("DiscountCodeOrder")
  codesUsedHere    DiscountCode[]    @relation("DiscountCodeUsedOn")
  payments         Payment[]
  invoice          Invoice?
  deliveries       Delivery[]

  @@unique([ticketDate, ticketLetter, ticketSeq])
  @@index([status, queueRank])
  @@index([customerId])
  @@index([salesUserId, createdAt])
  @@map("orders")
}

/// Snapshot of product, unit, factor, price and cap at validation time (RG-CMD-04, RG-ART-07).
model OrderLine {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  position       Int            @default(0)
  productId      String         @map("product_id") @db.Uuid
  productUnitId  String         @map("product_unit_id") @db.Uuid
  /// Price row in force at validation; null while the quote is a DRAFT.
  productPriceId String?        @map("product_price_id") @db.Uuid
  sku            String         @db.VarChar(64)
  name           String         @db.VarChar(200)
  unitLabel      String         @map("unit_label") @db.VarChar(40)
  factor         Decimal        @db.Decimal(12, 3)
  /// Quantity in the sale unit.
  qty            Decimal        @db.Decimal(12, 2)
  /// qty × factor, rounded to 2 decimals once, in base unit (RG-ART-06).
  baseQty        Decimal        @map("base_qty") @db.Decimal(12, 2)
  unitPrice      Decimal        @map("unit_price") @db.Decimal(14, 2)
  /// Cap resolved unit → product → category → setting, frozen here (RG-REM-01).
  maxDiscountPct Decimal        @default(0) @map("max_discount_pct") @db.Decimal(5, 2)
  discountPct    Decimal        @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  discountSource DiscountSource @default(NONE) @map("discount_source")
  discountCodeId String?        @map("discount_code_id") @db.Uuid
  lineTotal      Decimal        @map("line_total") @db.Decimal(14, 2)
  deliveredQty   Decimal        @default(0) @map("delivered_qty") @db.Decimal(12, 2)

  order            Order             @relation(fields: [orderId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  productUnit      ProductUnit       @relation(fields: [productUnitId], references: [id])
  productPrice     ProductPrice?     @relation(fields: [productPriceId], references: [id])
  discountCode     DiscountCode?     @relation(fields: [discountCodeId], references: [id])
  discountRequests DiscountRequest[]

  @@index([orderId])
  @@index([productId])
  @@map("order_lines")
}

/// Request to exceed the cap; only the owner decides (RG-REM-03). One PENDING per order (partial index).
model DiscountRequest {
  id              String                @id @default(uuid(7)) @db.Uuid
  orderId         String                @map("order_id") @db.Uuid
  /// Line the request covers. There is no order-wide discount (RG-REM-06); requests over
  /// several lines, each with its own pct, get a line table in T-033 (H22).
  lineId          String?               @map("line_id") @db.Uuid
  customerId      String?               @map("customer_id") @db.Uuid
  requestedPct    Decimal?              @map("requested_pct") @db.Decimal(5, 2)
  requestedAmount Decimal?              @map("requested_amount") @db.Decimal(14, 2)
  reason          String
  status          DiscountRequestStatus @default(PENDING)
  requestedById   String                @map("requested_by") @db.Uuid
  decidedById     String?               @map("decided_by") @db.Uuid
  decidedPct      Decimal?              @map("decided_pct") @db.Decimal(5, 2)
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  order       Order         @relation(fields: [orderId], references: [id])
  line        OrderLine?    @relation(fields: [lineId], references: [id])
  customer    Customer?     @relation(fields: [customerId], references: [id])
  requestedBy User          @relation("DiscountRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?         @relation("DiscountDecidedBy", fields: [decidedById], references: [id])
  /// Code issued when granted (discount_codes.request_id).
  code        DiscountCode?

  @@index([status, createdAt])
  @@index([orderId])
  @@map("discount_requests")
}

/// One-time code issued by the owner (RG-REM-04/05/07); single use enforced by
/// `UPDATE … WHERE status = 'ACTIVE'` in the attach transaction.
model DiscountCode {
  id            String             @id @default(uuid(7)) @db.Uuid
  code          String             @unique @db.VarChar(16)
  pct           Decimal?           @db.Decimal(5, 2)
  amount        Decimal?           @db.Decimal(14, 2)
  orderId       String?            @map("order_id") @db.Uuid
  customerId    String?            @map("customer_id") @db.Uuid
  requestId     String?            @unique @map("request_id") @db.Uuid
  issuedById    String             @map("issued_by") @db.Uuid
  issuedAt      DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  status        DiscountCodeStatus @default(ACTIVE)
  usedAt        DateTime?          @map("used_at") @db.Timestamptz(6)
  usedOnOrderId String?            @map("used_on_order_id") @db.Uuid
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(6)

  order       Order?           @relation("DiscountCodeOrder", fields: [orderId], references: [id])
  customer    Customer?        @relation(fields: [customerId], references: [id])
  request     DiscountRequest? @relation(fields: [requestId], references: [id])
  issuedBy    User             @relation(fields: [issuedById], references: [id])
  usedOnOrder Order?           @relation("DiscountCodeUsedOn", fields: [usedOnOrderId], references: [id])
  orderLines  OrderLine[]

  @@index([status, expiresAt])
  @@map("discount_codes")
}
