// Users, stations and sessions — CDC métier §3, annexe B ; CDC technique §5.

/// Fixed roles: the admin assigns them, never creates new ones (RG-USR-01).
enum Role {
  admin
  manager
  sales
  cashier
  warehouse
  owner

  @@map("role")
}

/// Any number of stations per type; at most one active DISPLAY (H11, partial unique index).
enum StationType {
  SALES
  REGISTER
  DELIVERY
  DISPLAY
  KIOSK

  @@map("station_type")
}

enum SessionOrigin {
  LAN
  REMOTE

  @@map("session_origin")
}

/// How the session was opened; `PIN` only on sessions opened before H57, which never reach owner/admin.
enum SessionAuthMethod {
  PIN
  PASSWORD
  PASSWORD_TOTP

  @@map("session_auth_method")
}

model User {
  id                     String    @id @default(uuid(7)) @db.Uuid
  username               String    @unique @db.VarChar(64)
  fullName               String    @map("full_name") @db.VarChar(120)
  roles                  Role[]
  /// argon2id hash (RG-USR-03): identifier and password everywhere, no PIN (H57).
  passwordHash           String?   @map("password_hash")
  /// A password set by the admin is replaced by the user's own at the next login (H20).
  passwordChangeRequired Boolean   @default(false) @map("password_change_required")
  /// TOTP (RG-USR-04): `totpSecret` is active once `totpEnabledAt` is set; enrolment writes the pending secret first.
  totpSecret             String?   @map("totp_secret")
  totpPendingSecret      String?   @map("totp_pending_secret")
  totpEnabledAt          DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  /// Last accepted TOTP time step: a code is single-use (RG-USR-04, RFC 6238 §5.2).
  totpLastStep           Int?      @map("totp_last_step")
  /// Lockout after 5 failures within 15 min (RG-USR-05).
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  lastFailedAt           DateTime? @map("last_failed_at") @db.Timestamptz(6)
  lockedUntil            DateTime? @map("locked_until") @db.Timestamptz(6)
  /// The owner's one-time activation code (RG-USR-10): its hash, valid until `activationExpiresAt`.
  activationCodeHash     String?   @map("activation_code_hash")
  activationExpiresAt    DateTime? @map("activation_expires_at") @db.Timestamptz(6)
  /// Ticket letter of a sales user (RG-TKT-01); unique among active sales users (partial index).
  ticketLetter           String?   @map("ticket_letter") @db.Char(1)
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  pricesSet           ProductPrice[]         @relation("PriceSetBy")
  stockMovements      StockMovement[]
  importBatches       ImportBatch[]
  ordersAsSales       Order[]                @relation("OrderSalesUser")
  ordersAsCashier     Order[]                @relation("OrderCashierUser")
  discountRequests    DiscountRequest[]      @relation("DiscountRequestedBy")
  discountDecisions   DiscountRequest[]      @relation("DiscountDecidedBy")
  discountWithdrawals DiscountRequest[]      @relation("DiscountWithdrawnBy")
  discountCodes       DiscountCode[]
  registerSessions    RegisterSession[]      @relation("RegisterCashier")
  registerApprovals   RegisterSession[]      @relation("RegisterValidatedBy")
  payments            Payment[]
  settlements         ReceivableSettlement[]
  creditNotesIssued   CreditNote[]           @relation("CreditNoteIssuedBy")
  creditNotesApproved CreditNote[]           @relation("CreditNoteApprovedBy")
  deliveries          Delivery[]
  issuesReported      DeliveryIssue[]        @relation("DeliveryIssueReportedBy")
  issuesDecided       DeliveryIssue[]        @relation("DeliveryIssueDecidedBy")
  auditEntries        AuditLog[]
  settingsUpdated     Setting[]
  pushSubscriptions   PushSubscription[]
  promotions          ProductPromotion[]
  discountRules       DiscountRule[]
  kioskBasketsTaken   KioskBasket[]

  @@map("users")
}

model Station {
  id          String      @id @default(uuid(7)) @db.Uuid
  type        StationType
  name        String      @db.VarChar(80)
  /// Address key of the public display (RG-DSP-01) or a kiosk (RG-BOR-01), no account needed.
  displayKey  String?     @unique @map("display_key") @db.VarChar(64)
  isActive    Boolean     @default(true) @map("is_active")
  /// sha256 of the key its paired device sends at login (T-015, RG-USR-09): one device per station.
  pairingHash String?     @unique @map("pairing_hash") @db.VarChar(64)
  pairedAt    DateTime?   @map("paired_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions         Session[]
  ordersAtRegister Order[]           @relation("OrderRegisterStation")
  registerSessions RegisterSession[]
  deliveries       Delivery[]
  auditEntries     AuditLog[]
  kioskBaskets     KioskBasket[]

  @@map("stations")
}

/// Server-side session (T5): the cookie carries a random token, only its sha256 is stored.
/// Revocation deletes the row; logins and logouts are traced in `audit_log`, not here.
model Session {
  id         String            @id @default(uuid(7)) @db.Uuid
  tokenHash  String            @unique @map("token_hash") @db.VarChar(64)
  userId     String            @map("user_id") @db.Uuid
  activeRole Role              @map("active_role")
  stationId  String?           @map("station_id") @db.Uuid
  origin     SessionOrigin
  authMethod SessionAuthMethod @map("auth_method")
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id])
  station Station? @relation(fields: [stationId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A device where the owner is told of each discount request, the app closed (T-033e, RG-DSH-05,
/// H55): the browser's push subscription, one per device, kept across logouts. The endpoint is
/// a capability URL of the browser's push service: never logged, audited nor sent back.
model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  /// The browser's keys (RFC 8291), base64url: the payload is encrypted for this device alone.
  p256dh    String   @db.VarChar(128)
  auth      String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}
