# Copy to .env (never committed) and adjust. All services read this file from Source/.

# --- PostgreSQL (dev container, infra/docker-compose.yml) ---
POSTGRES_USER=vente
POSTGRES_PASSWORD=vente
POSTGRES_DB=vente_web
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vente:vente@localhost:5433/vente_web

# --- API (apps/api) ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
# Shop time zone (RG-FMT-03)
TZ=Indian/Antananarivo

# --- Auth (T-012; CDC technique §2.2, §8; H19) ---
# Absolute session lifetime in hours, 1 to 12.
AUTH_SESSION_HOURS=12
# Origin assumed when the proxy sends no x-access-origin header. Dev only: remove in production.
AUTH_DEFAULT_ORIGIN=LAN
# Secure session cookie (HTTPS). Dev only: true (or removed) in production.
COOKIE_SECURE=false
# Reverse-proxy peers (IP/CIDR, comma-separated) trusted for x-access-origin and X-Forwarded-*.
TRUST_PROXY=127.0.0.1,::1

FILES_DIR=files
