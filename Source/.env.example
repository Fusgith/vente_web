# Copy to .env (never committed) and adjust. All services read this file from Source/.

# --- PostgreSQL (dev container, infra/docker-compose.yml) ---
POSTGRES_USER=vente
POSTGRES_PASSWORD=vente
POSTGRES_DB=vente_web
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vente:vente@localhost:5432/vente_web

# --- API (apps/api) ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
# Shop time zone (RG-FMT-03)
TZ=Indian/Antananarivo
