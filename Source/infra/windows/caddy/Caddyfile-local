# Shop server on the LAN only, while the shop has no domain yet (ADR-0009): https://LAN_IP with
# a certificate from Caddy's own authority, which each tablet and PC trusts once; http://LAN_IP
# shows how (appareils/) and serves that authority's certificate.
{
	admin off
	persist_config off
	storage file_system {$VW_DATA}/caddy
	# The installer trusts the authority on the server itself; a service has no desktop to ask.
	skip_install_trust
	# Tablets send no server name for an IP address.
	default_sni {$LAN_IP}
}

https://{$LAN_IP} {
	bind {$LAN_IP}
	tls internal
	import site.caddy lan
}

http://{$LAN_IP} {
	bind {$LAN_IP}
	handle /certificat.crt {
		root * {$VW_DATA}/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		root * {$VW_APP}/caddy/appareils
		try_files {path} /index.html
		file_server
	}
}
