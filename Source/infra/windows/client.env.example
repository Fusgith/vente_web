# Parameters of one shop (T-080, ADR-0008), given to `pnpm dist --client <file>`.
# Copy outside the repository (they hold secrets) and fill in; the installer moves them into the
# server's data folder (C:\ProgramData\VenteWeb\.env) and deletes its copy.

# --- The shop ---
# Name of the application for this shop, e.g. app.rasoa.mg; its DNS zone is at OVH. Empty: the
# shop is served on its LAN only, at https://LAN_IP, until it has one (ADR-0009); the OVH and
# WireGuard parameters below are then ignored.
APP_DOMAIN=
# Fixed LAN address of the server (set on the box's DHCP); the local DNS answers it for APP_DOMAIN.
LAN_IP=
# DNS that answers every other name (the box, or 1.1.1.1).
UPSTREAM_DNS=1.1.1.1
# Contact of push notifications to the owner (RG-DSH-05): mailto:name@domain; empty means
# https://APP_DOMAIN (https://LAN_IP without a domain).
VAPID_SUBJECT=

# --- TLS certificate by DNS-01 (caddy-dns/ovh): a key limited to this domain's zone; only with
# APP_DOMAIN ---
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# --- Remote access through the OVH relay (WireGuard, T-086); leave empty for LAN only ---
# This shop's private key and tunnel address (a plain IP, e.g. 10.66.0.2).
WG_PRIVATE_KEY=
WG_ADDRESS=
# The relay: its public key, IP:port (an IP, not a name: the tunnel must come up without the
# Internet DNS), and its tunnel address (e.g. 10.66.0.1).
RELAY_PUBLIC_KEY=
RELAY_ENDPOINT=
RELAY_WG_IP=

# --- Backups (T-081); the dumps and issued files always stay on this PC as well ---
# External disk (a folder on it, e.g. E:\VenteWeb); empty means none. Unplugged: copied later.
BACKUP_DISK=
# The shop's OVH Object Storage bucket (one per shop); empty means no copy out of the shop.
# The key lists, reads and writes, never deletes: the bucket's lifecycle rules expire the
# objects under sauvegardes/heures/ after 2 days, sauvegardes/jours/ 31, sauvegardes/mois/ 366.
# Encrypted by rclone crypt with BACKUP_PASSPHRASE, which the installer generates and shows
# once (sealed envelope kept out of the shop).
BACKUP_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
BACKUP_S3_REGION=gra
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
